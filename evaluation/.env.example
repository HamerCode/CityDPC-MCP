# Copy to evaluation/.env. Any OpenAI-compatible endpoint works.

# KI:Connect NRW (used for GPT-OSS and Mistral in the paper)
EVAL_BASE_URL=https://chat.kiconnect.nrw/api/v1
EVAL_API_KEY=replace-with-your-key
# OpenAI instead (GPT-5.4 Mini):
# EVAL_BASE_URL=https://api.openai.com/v1

# Defaults for command-line options
EVAL_MODEL=gpt-oss-120b
EVAL_API=completions            # responses | completions
EVAL_REASONING_EFFORT=high
EVAL_RUNS=10

# Throttling / limits
EVAL_MAX_CONCURRENT_REQUESTS=2
EVAL_REQUEST_SPACING_SECONDS=0.5
EVAL_MAX_TOOL_ROUNDS=80
EVAL_TIMEOUT_SECONDS=300

# Only for the code_interpreter setup: external Docker sandbox MCP server
# CODE_SANDBOX_MCP_BINARY=code-sandbox-mcp
