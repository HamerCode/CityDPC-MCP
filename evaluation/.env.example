KI_CONNECT_RESPONSES_URL=https://chat.kiconnect.nrw/api/v1/responses
KI_CONNECT_API_URL=https://chat.kiconnect.nrw/api/v1/chat/completions
KI_CONNECT_API_KEY=replace-with-your-virtual-api-key

# KI:Connect model ID from GET /api/v1/models.
EVAL_MODEL=mistralai-mistral-small-4-119b

# Parameterloser Start: python3 evals/run.py
EVAL_SETUP=mcp,no_tools
EVAL_TESTS=all
EVAL_COMPLETIONS=true
RUNS_PER_TEST=10
EVAL_WORKERS=2
KI_CONNECT_REASONING_EFFORT=

# Global request throttle for parallel lanes. Keep conservative to avoid 429s.
KI_CONNECT_MAX_CONCURRENT_REQUESTS=2
KI_CONNECT_REQUEST_SPACING_SECONDS=0.5
KI_CONNECT_MAX_TOOL_ROUNDS=80
TEST_TIMEOUT_SECONDS=300

# Local CityDPC MCP server. The runner is the MCP client.
MCP_SERVER_TRANSPORT=stdio
MCP_SERVER_LOG_FILE=evaluation_logs/mcp_server_stdio.log
CLEAN_STALE_MCP_SERVERS=true
